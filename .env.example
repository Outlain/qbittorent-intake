# Compose/Portainer deployment substitutions, not automatically application settings.
# Copy to .env for Compose; Portainer users set stack environment variables instead.
# Fill the owner that publishes YOUR Rust images. Empty means deployment must stop.
GITHUB_OWNER=
GITHUB_REPOSITORY_NAME=qbittorent-intake
IMAGE_TAG=latest

# Numeric container UID/GID. Provision host permissions for this chosen identity.
INTAKE_UID=10001
INTAKE_GID=10001
# Existing Docker network shared with qBittorrent's reachable API endpoint.
MEDIA_NETWORK=intake_network
# Published host interface/port; the service listens on container port 8000.
TI_UI_PUBLISH_IP=127.0.0.1
TI_UI_HOST_PORT=8095

# All host directories must already exist; binds never create missing directories.
# Keep database/settings/backups on local persistent storage, not NAS.
TI_DATA_HOST_DIR=/srv/torrent-intake/data
TI_LOCAL_STAGING_HOST_DIR=/srv/torrent-intake/staging
TI_MEDIA_HOST_DIR=/srv/torrent-intake/content
TI_EVENTS_HOST_DIR=/srv/torrent-intake/events
TI_QUARANTINE_HOST_DIR=/srv/torrent-intake/quarantine
TI_CLAMD_SOCKET_HOST_DIR=/srv/torrent-intake/socket
# Read-only definitions supplied by ONE separately managed updater.
CLAMAV_DEFS_HOST_DIR=/srv/torrent-intake/definitions
# Optional binds: uncomment the matching YAML mount after provisioning storage.
# TI_ARCHIVE_SCRATCH_HOST_DIR=/srv/torrent-intake/archive-scratch
# TI_COPY_TARGET_HOST_DIR=/srv/torrent-intake/copy-target
# TI_HOOKS_HOST_DIR=/srv/torrent-intake/hooks

# Docker resource limits; these do not change scanner coverage or concurrency.
INTAKE_MEMORY_LIMIT=2g
INTAKE_CPU_LIMIT=2.0
INTAKE_PIDS_LIMIT=256
INTAKE_TMPFS_SIZE=256m
INTAKE_STOP_GRACE_PERIOD=60s
CLAMD_MEMORY_LIMIT=8g
CLAMD_CPU_LIMIT=4.0
CLAMD_PIDS_LIMIT=128
CLAMD_TMPFS_SIZE=4g
CONTAINER_NOFILE_SOFT=4096
CONTAINER_NOFILE_HARD=8192
CONTAINER_LOG_MAX_SIZE=10m
CONTAINER_LOG_MAX_FILES=3
CONTAINER_RESTART_POLICY=unless-stopped

# Separate ClamD supervisor variables: seconds, seconds, MiB respectively.
DEFINITIONS_WAIT_TIMEOUT=1800
DEFINITIONS_MAX_AGE_SECONDS=172800
CLAMD_MAX_SCAN_SIZE_MIB=2000
# Optional supervisor paths must agree with the actual daemon configuration.
# DEFINITIONS_DIR=/var/lib/clamav
# CLAMD_SOCKET=/run/clamav/clamd.sock

# COMPLETE APPLICATION REFERENCE (intentionally inactive).
# Prefer Settings & Help or settings.json/restore. A host .env value is NOT sent
# to the application unless its matching service environment mapping is enabled.
# If enabled, that override wins over settings.json and locks its UI field.
# Do not uncomment every default: that would override your UI/restored settings.
# "unset" optional values must remain absent until you provide an actual value.
# BEGIN GENERATED APPLICATION ENVIRONMENT
# TI_APP_NAME | type: string | default: "torrent-intake"
# Accepted for compatibility with old settings files only; it has no effect. Use UI title to change the page heading.
# TI_APP_NAME="torrent-intake"
# TI_DEBUG | type: boolean | default: false
# Enables verbose application logging. Leave disabled for normal operation.
# TI_DEBUG=false
# TI_DATA_DIR | type: string | default: "/app/data"
# Bootstrap container directory containing SQLite, settings, and restore state. Keep its host mount on local SSD storage. Only TI_DATA_DIR in the container environment can relocate it.
# TI_DATA_DIR="/app/data"
# TI_DATABASE_URL | type: string | default: "sqlite:////app/data/torrent_intake.db"
# SQLite database containing jobs, checkpoints, migrations and scanner controls. Only a SQLite file inside TI_DATA_DIR is supported; other database engines are not available.
# TI_DATABASE_URL="sqlite:////app/data/torrent_intake.db"
# TI_QBT_HOST | type: string | default: "http://qbittorrent:8080"
# Private Web API endpoint reachable from Torrent Intake, for example http://qbittorrent:8080 on a shared Docker network. This is separate from the URL you open in your browser.
# TI_QBT_HOST="http://qbittorrent:8080"
# TI_QBT_USERNAME | type: string | default: "admin"
# Account name used for authenticated qBittorrent API calls.
# TI_QBT_USERNAME="admin"
# TI_QBT_PASSWORD | type: string | default: "REPLACE_WITH_STRONG_PASSWORD"
# Password used for qBittorrent API authentication. The value is never returned to the UI.
# TI_QBT_PASSWORD="REPLACE_WITH_STRONG_PASSWORD"
# TI_QBT_VERIFY_CERTIFICATE | type: boolean | default: false
# Validates the qBittorrent HTTPS certificate when TLS is used.
# TI_QBT_VERIFY_CERTIFICATE=false
# TI_QBT_REQUEST_TIMEOUT_SECONDS | type: nonnegative integer | default: 20
# Maximum wait for an individual qBittorrent API request, in seconds. Minimum: 1.
# TI_QBT_REQUEST_TIMEOUT_SECONDS=20
# TI_QBT_WEB_URL | type: optional string | default: unset
# Browser-safe link shown in the UI. This can differ from the private API URL used by the container.
# TI_QBT_WEB_URL=
# TI_INTAKE_CATEGORY | type: string | default: "intake"
# qBittorrent category assigned while a torrent is managed by Intake.
# TI_INTAKE_CATEGORY="intake"
# TI_MANAGED_TAG | type: string | default: "torrent_intake"
# Required qBittorrent tag proving that a torrent remains under Torrent Intake control.
# TI_MANAGED_TAG="torrent_intake"
# TI_AUTO_CREATE_FINAL_CATEGORY | type: boolean | default: true
# Allows Torrent Intake to create a requested final qBittorrent category when it does not already exist.
# TI_AUTO_CREATE_FINAL_CATEGORY=true
# TI_LOCAL_STAGING_ROOT | type: string | default: "/staging-local"
# Exact container path used for locally staged torrents. qBittorrent must see the same content at the same path.
# TI_LOCAL_STAGING_ROOT="/staging-local"
# TI_NAS_STAGING_ROOT | type: string | default: "/downloads/torrent-intake/staging"
# Legacy single NAS path, used only while the named NAS list is empty. Existing job choices stay pinned. qBittorrent must see identical container paths.
# TI_NAS_STAGING_ROOT="/downloads/torrent-intake/staging"
# TI_NAS_STAGING_LOCATIONS | type: JSON array | default: []
# Named temporary download locations mounted at the same paths in Intake and qBittorrent. A marker is an existing file on the NAS (absolute container path); Intake never creates it. Existing job paths cannot be removed while in use.
# TI_NAS_STAGING_LOCATIONS=[]
# TI_DEFAULT_NAS_STAGING_ID | type: optional string | default: unset
# Exactly one named NAS used for new jobs and local overflow. Existing jobs retain their saved fallback. This does not select the final library destination.
# TI_DEFAULT_NAS_STAGING_ID=
# TI_FINAL_PARENT_PREFIX | type: string | default: "/downloads"
# Primary canonical media boundary allowed for clean promotion destinations.
# TI_FINAL_PARENT_PREFIX="/downloads"
# TI_FINAL_PARENT_PREFIXES | type: optional string | default: unset
# Optional comma-separated canonical media boundaries allowed in addition to the primary final root.
# TI_FINAL_PARENT_PREFIXES=
# TI_LOCAL_OVERFLOW_POLICY | type: string | default: "queue"
# Action taken when aggregate local staging capacity is unavailable for another torrent.
# TI_LOCAL_OVERFLOW_POLICY="queue"
# TI_LOCAL_MAX_GIB | type: nonnegative integer | default: 200
# A torrent larger than this GiB limit is directed to NAS staging instead of local staging. Minimum: 1.
# TI_LOCAL_MAX_GIB=200
# TI_LOCAL_FREE_SPACE_BUFFER_GIB | type: nonnegative integer | default: 5
# GiB kept unused when Torrent Intake calculates safe local staging capacity. Minimum: 0.
# TI_LOCAL_FREE_SPACE_BUFFER_GIB=5
# TI_POLLING_INTERVAL_SECONDS | type: nonnegative integer | default: 300
# How often the background reconciliation pass checks qBittorrent when no completion callback arrives. Minimum: 1.
# TI_POLLING_INTERVAL_SECONDS=300
# TI_COMPLETION_GRACE_SECONDS | type: nonnegative integer | default: 15
# Delay after a completion signal before Torrent Intake begins its final completion and pause checks. Minimum: 0.
# TI_COMPLETION_GRACE_SECONDS=15
# TI_COMPLETION_EVENT_TOKEN | type: optional string | default: unset
# Authenticates qBittorrent completion callbacks. The value is never returned to the UI.
# TI_COMPLETION_EVENT_TOKEN=
# TI_SCANNER_BACKEND | type: string | default: "clamd"
# Compatibility selector: only clamd is supported. It may be omitted; there is no clamscan or alternate backend.
# TI_SCANNER_BACKEND="clamd"
# TI_CLAMD_SOCKET_PATH | type: string | default: "/run/clamav/clamd.sock"
# Private Unix socket shared only with the Torrent Intake ClamD sidecar.
# TI_CLAMD_SOCKET_PATH="/run/clamav/clamd.sock"
# TI_SCANNER_POLICY_VERSION | type: string | default: "clamav-policy-v5-media-attachments"
# Identity of the scan policy stored with checkpoints. Changing it invalidates incompatible clean checkpoints.
# TI_SCANNER_POLICY_VERSION="clamav-policy-v5-media-attachments"
# TI_SCANNER_MAX_FILE_MIB | type: nonnegative integer | default: 2000
# Raw-size boundary for one native ClamD stream. Larger RAR/ZIP archives use member extraction; verified video and raw TrueHD use bounded windows. Eligible native size-limit failures use the same routes. Allowed: 1 through 2000.
# TI_SCANNER_MAX_FILE_MIB=2000
# TI_SCANNER_HEALTH_CACHE_SECONDS | type: nonnegative integer | default: 15
# How long a successful ClamD health result may be reused, in seconds. Minimum: 1.
# TI_SCANNER_HEALTH_CACHE_SECONDS=15
# TI_SCANNER_CONNECT_TIMEOUT_SECONDS | type: nonnegative integer | default: 5
# Maximum time to establish a private socket connection, in seconds. Minimum: 1.
# TI_SCANNER_CONNECT_TIMEOUT_SECONDS=5
# TI_SCANNER_SCAN_TIMEOUT_SECONDS | type: nonnegative integer | default: 1200
# Maximum total client wait for one streamed file scan, in seconds. Minimum: 1.
# TI_SCANNER_SCAN_TIMEOUT_SECONDS=1200
# TI_SCANNER_DEFINITIONS_WARN_HOURS | type: nonnegative integer | default: 36
# Definition age in hours at which the UI and events begin warning before scans are blocked. Minimum: 1.
# TI_SCANNER_DEFINITIONS_WARN_HOURS=36
# TI_SCANNER_DEFINITIONS_STALE_HOURS | type: nonnegative integer | default: 72
# Definition age in hours at which scanning fails closed until current definitions are available. Minimum: 1.
# TI_SCANNER_DEFINITIONS_STALE_HOURS=72
# TI_LARGE_MEDIA_ENABLED | type: boolean | default: true
# Routes oversized verified videos and narrowly validated raw TrueHD audio, plus eligible media whose native scan reaches a parser/expanded-data limit, through full-byte overlapping ClamD windows.
# TI_LARGE_MEDIA_ENABLED=true
# TI_LARGE_MEDIA_MAX_FILE_GIB | type: nonnegative integer | default: 100
# Hard GiB ceiling for the bounded large-media path. Larger individual files remain held without a clean verdict. Minimum: 1.
# TI_LARGE_MEDIA_MAX_FILE_GIB=100
# TI_LARGE_MEDIA_CHUNK_MIB | type: nonnegative integer | default: 512
# MiB sent in each independent ClamD window. It must remain below the native ClamD stream limit. Minimum: 1.
# TI_LARGE_MEDIA_CHUNK_MIB=512
# TI_LARGE_MEDIA_MIN_CHUNK_MIB | type: nonnegative integer | default: 64
# Smallest MiB window allowed for a raw stream/file size limit. Expansion, recursion, and unknown limits within a window remain blocked instead of being subdivided. Minimum: 1.
# TI_LARGE_MEDIA_MIN_CHUNK_MIB=64
# TI_LARGE_MEDIA_OVERLAP_KIB | type: nonnegative integer | default: 1024
# KiB repeated between neighboring windows to preserve short byte signatures at boundaries; this cannot preserve every signature or container parser context. Minimum: 0.
# TI_LARGE_MEDIA_OVERLAP_KIB=1024
# TI_LARGE_MEDIA_PROBE_TIMEOUT_SECONDS | type: nonnegative integer | default: 120
# Maximum time allowed for ffprobe to verify the real container and stream layout of an oversized file. Minimum: 1.
# TI_LARGE_MEDIA_PROBE_TIMEOUT_SECONDS=120
# TI_LARGE_MEDIA_SCAN_TIMEOUT_SECONDS | type: nonnegative integer | default: 172800
# Total deadline for validating and reading every window of one oversized media file. Minimum: 1.
# TI_LARGE_MEDIA_SCAN_TIMEOUT_SECONDS=172800
# TI_FFPROBE_BINARY | type: string | default: "/usr/bin/ffprobe"
# Image-provided ffprobe path used to validate oversized media. The Docker image installs it at build time.
# TI_FFPROBE_BINARY="/usr/bin/ffprobe"
# TI_FFMPEG_BINARY | type: string | default: "/usr/bin/ffmpeg"
# Image-provided tool for bounded attachment extraction. It does not transcode media files or unpack torrent archives.
# TI_FFMPEG_BINARY="/usr/bin/ffmpeg"
# TI_MEDIA_ATTACHMENT_MAX_MIB | type: nonnegative integer | default: 16
# MiB allowed for one extracted attachment, between 1 and 64. Each attachment must complete a native ClamD scan; it is never chunked or skipped. Allowed: 1 through 64.
# TI_MEDIA_ATTACHMENT_MAX_MIB=16
# TI_MEDIA_ATTACHMENT_TOTAL_MIB | type: nonnegative integer | default: 64
# Maximum MiB extracted from one media file, at most 256. Cover images reserve their per-attachment maximum because their size is unknown before extraction. Allowed: 1 through 256.
# TI_MEDIA_ATTACHMENT_TOTAL_MIB=64
# TI_ARCHIVE_ENABLED | type: boolean | default: true
# Inspect oversized RAR/ZIP archives and eligible native size-limit failures using temporary extracted copies. Original archives and torrent folders are preserved.
# TI_ARCHIVE_ENABLED=true
# TI_ARCHIVE_SCRATCH_DIR | type: optional string | default: unset
# Existing container directory on local or NAS storage. Intake uses a private archive-scan subdirectory. Leave blank to use TI_DATA_DIR. Configure the matching writable Docker mount first; unavailable custom storage never falls back to the data disk.
# TI_ARCHIVE_SCRATCH_DIR=
# TI_ARCHIVE_SCRATCH_MOUNT_MARKER | type: optional string | default: unset
# Optional absolute path to an existing readable marker file inside custom scratch storage. A missing marker blocks archive inspection; Intake never creates it. Leave blank to disable the marker check.
# TI_ARCHIVE_SCRATCH_MOUNT_MARKER=
# TI_ARCHIVE_MAX_FILE_GIB | type: nonnegative integer | default: 100
# Maximum GiB for a source RAR/ZIP archive admitted to member scanning. Allowed: 1 through 1024.
# TI_ARCHIVE_MAX_FILE_GIB=100
# TI_ARCHIVE_MAX_EXPANDED_GIB | type: nonnegative integer | default: 20
# Maximum total GiB extracted per archive, including nested archive copies. Scratch files use the selected scratch filesystem and are removed after inspection. Allowed: 1 through 1024.
# TI_ARCHIVE_MAX_EXPANDED_GIB=20
# TI_ARCHIVE_MAX_FILES | type: nonnegative integer | default: 10000
# Total entries, including directories and nested archives, admitted during one archive inspection. Allowed: 1 through 100000.
# TI_ARCHIVE_MAX_FILES=10000
# TI_ARCHIVE_MAX_DEPTH | type: nonnegative integer | default: 4
# Maximum RAR/ZIP nesting levels sharing the extraction budget; the outer archive is level one. Allowed: 1 through 8.
# TI_ARCHIVE_MAX_DEPTH=4
# TI_ARCHIVE_SCAN_TIMEOUT_SECONDS | type: nonnegative integer | default: 7200
# Total seconds allowed for extraction and all member scans of one archive. Allowed: 1 through 172800.
# TI_ARCHIVE_SCAN_TIMEOUT_SECONDS=7200
# TI_ARCHIVE_FREE_SPACE_BUFFER_GIB | type: nonnegative integer | default: 1
# GiB kept free on the selected scratch filesystem while temporary members are extracted. Allowed: 1 through 1024.
# TI_ARCHIVE_FREE_SPACE_BUFFER_GIB=1
# TI_PER_JOB_SCAN_WORKERS | type: nonnegative integer | default: 1
# Maximum large-media byte ranges from one torrent that may be streamed to ClamD simultaneously. Allowed: 1 through 4.
# TI_PER_JOB_SCAN_WORKERS=1
# TI_CLAMD_MAX_INFLIGHT_REQUESTS | type: nonnegative integer | default: 4
# Hard application-wide limit for simultaneous ClamD INSTREAM requests across every active torrent. Keep it at or below ClamD MaxThreads. Allowed: 1 through 4.
# TI_CLAMD_MAX_INFLIGHT_REQUESTS=4
# TI_MAX_CONCURRENT_SCANS | type: nonnegative integer | default: 2
# Default torrent scan slots for a new queue and after a temporary boost ends. Existing slot requests are saved in SQLite. Minimum: 1.
# TI_MAX_CONCURRENT_SCANS=2
# TI_MAX_SCAN_SLOTS | type: nonnegative integer | default: 4
# Maximum slot count the runtime Scan Queue control is permitted to request. Minimum: 1.
# TI_MAX_SCAN_SLOTS=4
# TI_MAX_CONCURRENT_LARGE_SCANS | type: nonnegative integer | default: 1
# Maximum number of torrents above the large-job threshold that can scan at the same time. Minimum: 1.
# TI_MAX_CONCURRENT_LARGE_SCANS=1
# TI_LARGE_SCAN_GIB | type: nonnegative integer | default: 2
# Torrent size in GiB at which the separate large-scan concurrency bound applies. Minimum: 1.
# TI_LARGE_SCAN_GIB=2
# TI_SCAN_SCHEDULER_INTERVAL_SECONDS | type: nonnegative integer | default: 3
# Delay between scheduler attempts to claim pending scan work, in seconds. Minimum: 1.
# TI_SCAN_SCHEDULER_INTERVAL_SECONDS=3
# TI_SCAN_LEASE_SECONDS | type: nonnegative integer | default: 90
# Restart-recovery lease protecting an actively owned scan, in seconds. Minimum: 1.
# TI_SCAN_LEASE_SECONDS=90
# TI_SCAN_HEARTBEAT_SECONDS | type: nonnegative integer | default: 10
# How frequently an active worker refreshes its durable scan lease, in seconds. Minimum: 1.
# TI_SCAN_HEARTBEAT_SECONDS=10
# TI_SCAN_RETRY_BASE_SECONDS | type: nonnegative integer | default: 30
# Initial delay used by exponential retry after scanner failures, in seconds. Minimum: 1.
# TI_SCAN_RETRY_BASE_SECONDS=30
# TI_SCAN_MAX_FAILURES | type: nonnegative integer | default: 3
# Failure count after which a file/job requires explicit operator retry. Minimum: 1.
# TI_SCAN_MAX_FAILURES=3
# TI_SCAN_YIELD_AFTER_FILES | type: nonnegative integer | default: 10
# Number of successfully checkpointed files processed before a worker yields so other queued jobs can progress. Minimum: 1.
# TI_SCAN_YIELD_AFTER_FILES=10
# TI_PAUSE_CONFIRMATION_TIMEOUT_SECONDS | type: nonnegative integer | default: 30
# Maximum wait for qBittorrent to confirm a torrent is paused before scanning or a destructive action. Minimum: 1.
# TI_PAUSE_CONFIRMATION_TIMEOUT_SECONDS=30
# TI_INFECTED_ACTION | type: string | default: "hold"
# Action after a verified malware detection. This safety-critical value cannot be changed from the UI.
# TI_INFECTED_ACTION="hold"
# TI_QUARANTINE_ROOT | type: string | default: "/quarantine"
# Canonical quarantine boundary used only when the infected-content action is quarantine.
# TI_QUARANTINE_ROOT="/quarantine"
# TI_EVENT_DIR | type: string | default: "/events"
# Writable spool where Torrent Intake atomically emits notifier events. It must be persistent.
# TI_EVENT_DIR="/events"
# TI_POST_PROMOTION_ENABLED | type: boolean | default: false
# Run the deployment-configured trusted script only after clean scanning, completed final promotion, delay and revalidation. No scripts are queued for historical completed jobs. Scripts have Intake's permissions, not a separate sandbox.
# TI_POST_PROMOTION_ENABLED=false
# TI_POST_PROMOTION_SCRIPT | type: optional string | default: unset
# Absolute executable path under /hooks, mounted read-only. Configure in Portainer or settings.json while stopped. Script files are NOT included in portable backups. Never point this at downloaded content.
# TI_POST_PROMOTION_SCRIPT=
# TI_POST_PROMOTION_COPY_ENABLED | type: boolean | default: false
# Enable one-time copies for newly promoted torrents whose final parent matches an enabled copy rule. No match means no copy. Originals are retained and collisions are protected. Choose built-in copying OR a custom script; neither is a continuous folder sync.
# TI_POST_PROMOTION_COPY_ENABLED=false
# TI_POST_PROMOTION_COPY_DESTINATION | type: optional string | default: unset
# Retained for older settings and backups. This global destination is ignored for newly promoted jobs: configure Copy destination rules instead. Previously queued copies keep their pinned destination and layout.
# TI_POST_PROMOTION_COPY_DESTINATION=
# TI_POST_PROMOTION_COPY_RULES | type: JSON array | default: []
# Map final-library source roots to existing destinations under /copy-target. The most specific enabled source containing the job's final parent wins; unmatched jobs are not copied. Disabled rules are ignored, so a broader enabled rule can still match. Relative folders are preserved, without a per-job wrapper. Queued jobs retain their saved rule. Maximum 32 rules.
# TI_POST_PROMOTION_COPY_RULES=[]
# TI_POST_PROMOTION_DELAY_SECONDS | type: nonnegative integer | default: 5
# Minimum delay after verified promotion before checking again and copying or running the script; not a substitute for move verification. Allowed: 0 through 3600.
# TI_POST_PROMOTION_DELAY_SECONDS=5
# TI_POST_PROMOTION_TIMEOUT_SECONDS | type: nonnegative integer | default: 7200
# Maximum copy or script runtime, followed by a short shutdown grace period. A timeout does not rescan or move the promoted torrent again. Inspect partial copies before retrying. Allowed: 1 through 604800.
# TI_POST_PROMOTION_TIMEOUT_SECONDS=7200
# TI_UI_TITLE | type: string | default: "Torrent Intake"
# Heading displayed at the top of the Torrent Intake interface.
# TI_UI_TITLE="Torrent Intake"
# END GENERATED APPLICATION ENVIRONMENT
